# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
/supabase/.temp/

# Local, unapproved AI labeling drafts and image previews
/.local/photograph-labeling/

# Local design-review artifacts
/.impeccable/

# Read-only, unapproved palette comparison artifacts
/.local/palette-review/

# Private catalogue snapshots and palette-backfill journals
/.local/palette-backfill/
